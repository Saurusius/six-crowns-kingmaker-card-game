<section class="scg-profile-shell scg-collection-shell {{#if compactOptions}}is-options-compact{{/if}} {{#if compactCards}}is-card-view-compact{{/if}}">
  <header class="scg-profile-toolbar">
    <div>
      <h1>Collection de {{userName}}</h1>
      <p>Les cartes non obtenues restent masquées : leur nom, leur rareté, leur ligne et leurs effets ne sont pas révélés.</p>
    </div>
    <div class="scg-profile-actions">
      <span class="scg-booster-credit-badge"><i class="fa-solid fa-ticket"></i> {{#if isGM}}Ouverture MJ illimitée{{else}}{{boosterCredits}} booster(s) à ouvrir{{/if}}</span>
      <button type="button" data-action="open-booster" {{#unless canOpenBooster}}disabled{{/unless}}><i class="fa-solid fa-box-open"></i> {{boosterButtonLabel}}</button>
      <button type="button" data-action="open-three-boosters" {{#unless canOpenBooster}}disabled{{/unless}}><i class="fa-solid fa-boxes-stacked"></i> Ouvrir jusqu’à 3</button>
      <button type="button" data-action="open-deck-builder"><i class="fa-solid fa-hammer"></i> Construire un deck</button>
      <button type="button" data-action="open-glossary"><i class="fa-solid fa-book-open"></i> Glossaire</button>
      <button type="button" data-action="toggle-card-view" aria-pressed="{{compactCards}}"><i class="{{cardViewToggleIcon}}"></i> {{cardViewToggleLabel}}</button>
      <button type="button" data-action="toggle-options-size" aria-pressed="{{compactOptions}}"><i class="{{optionsToggleIcon}}"></i> {{optionsToggleLabel}}</button>
    </div>
  </header>

  <section class="scg-collection-summary">
    <strong>{{discovered}} / {{total}} cartes découvertes</strong>
    <span>{{copies}} exemplaire(s) possédé(s)</span>
    <span>{{completionPercent}} % de la collection révélée</span>
  </section>

  <section class="scg-faction-counters" aria-label="Progression par collection">
    {{#each factionCounters}}
      <article class="scg-faction-counter scg-collection-theme-{{id}}" data-faction-theme="{{id}}">
        <span class="scg-collection-symbol">{{symbol}}</span>
        <div>
          <strong>{{label}}</strong>
          <small>{{discovered}} / {{total}} cartes · {{completionPercent}} %</small>
        </div>
      </article>
    {{/each}}
  </section>

  <section class="scg-profile-filters scg-collection-filters">
    <label class="scg-filter-search">
      <span>Rechercher par nom</span>
      <input type="search" name="collection-search" value="{{search}}" placeholder="Nom d’une carte possédée…">
    </label>
    <label>
      <span>Collection</span>
      <select name="collection-faction">
        <option value="all">Toutes les collections</option>
        {{#each factionOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label>
      <span>Rareté</span>
      <select name="collection-rarity">
        <option value="all">Toutes les raretés</option>
        {{#each rarityOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label>
      <span>Ligne</span>
      <select name="collection-row">
        <option value="all">Toutes les lignes</option>
        {{#each rowOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label>
      <span>Possession</span>
      <select name="collection-ownership">
        {{#each ownershipOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <button type="button" class="scg-filter-reset" data-action="reset-filters"><i class="fa-solid fa-filter-circle-xmark"></i> Réinitialiser</button>
  </section>


  {{#if hasComparison}}
    <section class="scg-card-comparison">
      <header><div><h2><i class="fa-solid fa-scale-balanced"></i> Comparaison de cartes</h2><p>Sélectionnez jusqu’à deux cartes depuis leur fiche pour comparer leurs rôles.</p></div><div><span>{{comparisonCount}} / 2</span><button type="button" data-action="clear-comparison"><i class="fa-solid fa-xmark"></i> Effacer</button></div></header>
      <div class="scg-comparison-grid">
        {{#each comparisonCards}}
          <article class="scg-rarity-{{rarity}}">
            <button type="button" data-action="remove-comparison" data-card-id="{{id}}" aria-label="Retirer {{name}}">×</button>
            <div class="scg-comparison-art">{{#if hasArt}}<img src="{{artMedium}}" alt="Illustration de {{name}}">{{else}}<span>{{factionSymbol}}</span>{{/if}}<b>{{strength}}</b></div>
            <div><small>{{rarityLabel}} · {{factionLabel}}</small><h3>{{name}}</h3><p class="scg-card-symbol-line"><span><i class="{{typeIcon}}"></i> {{typeLabel}}</span>{{#each rowBadges}}<span title="{{label}}"><i class="{{icon}}"></i> {{label}}</span>{{/each}}</p><div class="scg-effect-icons">{{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}</div><p class="scg-card-rules-text" tabindex="0" aria-label="Effet de {{name}} : {{text}}">{{{textHtml}}}</p></div>
          </article>
        {{/each}}
        {{#unless comparisonFull}}<article class="is-comparison-placeholder"><i class="fa-solid fa-plus"></i><strong>Choisissez une deuxième carte</strong></article>{{/unless}}
      </div>
    </section>
  {{/if}}

  <details class="scg-collapsible-panel scg-trade-center" open>
    <summary><span><i class="fa-solid fa-handshake"></i><b>Centre d’échanges</b><small>Cartes réservées jusqu’à la résolution de l’offre.</small></span><em>{{tradeCenter.incoming.length}} reçue(s) · {{tradeCenter.outgoing.length}} envoyée(s)</em><i class="fa-solid fa-chevron-down"></i></summary>
    <div class="scg-collapsible-content"><div class="scg-trade-columns">
      <details {{#if hasIncomingTrades}}open{{/if}}><summary>Offres reçues <b>{{tradeCenter.incoming.length}}</b></summary><div class="scg-trade-list">
        {{#each tradeCenter.incoming}}
          <article data-trade-offer data-offer-id="{{id}}"><header><strong>{{fromName}}</strong><small>{{dateLabel}}</small></header><p>Vous recevez <b>{{offeredLabel}}</b></p><p>Vous donnez <b>{{requestedLabel}}</b></p>
            {{#if requestedIsRarity}}<label><span>Carte {{requestedRarityLabel}} à céder</span><select name="trade-rarity-card">{{#each rarityChoices}}<option value="{{id}}">{{name}} · ×{{count}}</option>{{else}}<option value="">Aucune carte disponible</option>{{/each}}</select></label>{{/if}}
            <footer><button type="button" class="is-danger" data-action="trade-reject" data-offer-id="{{id}}"><i class="fa-solid fa-xmark"></i> Refuser</button><button type="button" data-action="trade-accept" data-offer-id="{{id}}" {{#unless hasRarityChoices}}disabled{{/unless}}><i class="fa-solid fa-check"></i> Accepter</button></footer>
          </article>
        {{else}}<p class="scg-trade-empty">Aucune offre reçue.</p>{{/each}}
      </div></details>
      <details {{#if hasOutgoingTrades}}open{{/if}}><summary>Offres envoyées <b>{{tradeCenter.outgoing.length}}</b></summary><div class="scg-trade-list">
        {{#each tradeCenter.outgoing}}<article data-trade-offer><header><strong>À {{toName}}</strong><small>{{dateLabel}}</small></header><p>Vous proposez <b>{{offeredLabel}}</b></p><p>Vous demandez <b>{{requestedLabel}}</b></p><footer><button type="button" class="is-danger" data-action="trade-cancel" data-offer-id="{{id}}"><i class="fa-solid fa-ban"></i> Annuler</button></footer></article>{{else}}<p class="scg-trade-empty">Aucune offre envoyée.</p>{{/each}}
      </div></details>
      <details><summary>Historique <b>{{tradeCenter.history.length}}</b></summary><div class="scg-trade-list scg-trade-history-list">
        {{#each tradeCenter.history}}<article><header><strong>{{fromName}} → {{toName}}</strong><small>{{dateLabel}}</small></header><p>{{offeredLabel}} contre {{requestedLabel}}</p><span class="scg-trade-status is-{{status}}">{{statusLabel}}</span>{{#if note}}<small>{{note}}</small>{{/if}}</article>{{else}}<p class="scg-trade-empty">Aucun échange archivé.</p>{{/each}}
      </div></details>
    </div></div>
  </details>

  {{#if hasBoosterHistory}}
    <details class="scg-collapsible-panel scg-booster-history" open><summary><span><i class="fa-solid fa-clock-rotate-left"></i><b>Derniers boosters</b><small>Vos tirages récents et nouvelles cartes.</small></span><em>{{boosterHistory.length}} ouverture(s)</em><i class="fa-solid fa-chevron-down"></i></summary><div class="scg-collapsible-content"><div>{{#each boosterHistory}}<article class="scg-rarity-{{highestRarity}}"><header><strong>{{dateLabel}}</strong><span>{{newCount}} nouvelle(s)</span></header><p>{{#each cards}}{{name}}{{#unless @last}} · {{/unless}}{{/each}}</p></article>{{/each}}</div></div></details>
  {{/if}}

  <details class="scg-collapsible-panel scg-exchange-tools" open>
    <summary><span><i class="fa-solid fa-recycle"></i><b>Recyclage des doublons</b><small>Échangez exactement 10 exemplaires contre un ticket.</small></span><em>{{ownedCards.length}} carte(s) disponible(s)</em><i class="fa-solid fa-chevron-down"></i></summary>
    <div class="scg-collapsible-content"><div class="scg-recycle-grid">
      {{#each ownedCards}}<label><span>{{name}} (×{{count}})</span><input type="number" min="0" max="{{count}}" value="0" data-recycle-count data-card-id="{{id}}"></label>{{/each}}
    </div>
    <button type="button" data-action="recycle-cards"><i class="fa-solid fa-ticket"></i> Recycler 10 cartes contre 1 ticket</button></div>
  </details>

  {{#if isGM}}
    <section class="scg-gm-tools">
      <header>
        <div>
          <h2><i class="fa-solid fa-user-shield"></i> Outils MJ</h2>
          <p>Ces actions modifient directement la collection et les boosters disponibles du profil Foundry ciblé.</p>
        </div>
      </header>
      <div class="scg-gm-tools-grid">
        <label>
          <span>Joueur ciblé</span>
          <select name="gm-target-user">
            {{#each gmUsers}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} — {{activeLabel}} — {{boosterCredits}} booster(s)</option>{{/each}}
          </select>
        </label>
        <label class="scg-gm-card-select">
          <span>Carte à donner</span>
          <select name="gm-card">
            {{#each gmCards}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} — {{factionLabel}} — {{rarityLabel}}</option>{{/each}}
          </select>
        </label>
        <label>
          <span>Exemplaires de la carte</span>
          <input type="number" name="gm-card-count" value="1" min="1" max="100">
        </label>
        <label>
          <span>Boosters à offrir</span>
          <input type="number" name="gm-booster-count" value="1" min="1" max="100">
        </label>
        <div class="scg-gm-actions">
          <button type="button" data-action="gm-give-card"><i class="fa-solid fa-gift"></i> Donner la carte</button>
          <button type="button" data-action="gm-grant-boosters"><i class="fa-solid fa-ticket"></i> Offrir les boosters</button>
          <button type="button" class="is-danger" data-action="gm-reset-collection"><i class="fa-solid fa-trash-arrow-up"></i> Réinitialiser la collection</button>
        </div>
      </div>
    </section>
  {{/if}}

  <div class="scg-collection-scroll">
    {{#each groups}}
      <section class="scg-collection-group scg-collection-theme-{{id}}" data-collection-group="{{id}}">
        <header class="scg-collection-group-header">
          <div><span class="scg-collection-symbol">{{symbol}}</span><h2>{{label}}</h2></div>
          <div class="scg-collection-progress">
            <strong>{{discovered}} / {{total}}</strong>
            <span>{{completionPercent}} % · {{copies}} exemplaire(s)</span>
          </div>
        </header>

        <div class="scg-collection-grid">
          {{#each cards}}
            <article class="scg-collection-card {{#if discovered}}scg-rarity-{{rarity}}{{else}}is-hidden-card{{/if}}"
              data-collection-card data-scg-card-popup
              data-rarity="{{filterRarity}}"
              data-rows="{{filterRows}}"
              data-ownership="{{ownershipState}}"
              data-search="{{#if discovered}}{{displayName}} {{id}} {{factionLabel}} {{rarityLabel}} {{typeLabel}}{{else}}Carte inconnue {{id}}{{/if}}"
              data-card-id="{{id}}" data-owned-count="{{ownedCount}}" data-trade-available-count="{{tradeAvailableCount}}" data-name="{{name}}" data-art="{{artFull}}" data-text="{{text}}">
              {{#if discovered}}
                <div class="scg-collection-card-art {{#if hasArt}}has-art{{/if}}">
                  {{#if hasArt}}
                    <img src="{{artFull}}" alt="Illustration de {{name}}" loading="lazy" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">
                  {{else}}
                    <span class="scg-collection-card-symbol">{{factionSymbol}}</span>
                  {{/if}}
                  {{#if playable}}<strong class="scg-collection-strength">{{strength}}</strong>{{/if}}
                  <span class="scg-rarity-dot scg-rarity-{{rarity}}" title="{{rarityLabel}}" aria-label="Rareté : {{rarityLabel}}"><i class="{{rarityIcon}}"></i></span>
                </div>
                <div class="scg-collection-card-body">
                  <strong title="{{name}}">{{name}}</strong>
                  <small title="{{id}} · {{factionLabel}}">{{id}} · {{factionLabel}}</small>
                  <span class="scg-card-type-line"><i class="{{typeIcon}}"></i> <b>{{typeLabel}}</b> · Force {{strength}}</span>
                  <span class="scg-card-symbol-line">{{#each rowBadges}}<span title="{{label}}"><i class="{{icon}}"></i> {{label}}</span>{{/each}}</span>
                  <div class="scg-effect-icons scg-collection-traits">
                    {{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}
                  </div>
                  {{#if text}}<p class="scg-card-rules-text" tabindex="0" aria-label="Effet de {{name}} : {{text}}">{{{textHtml}}}</p>{{/if}}
                  <div class="scg-collection-card-actions">
                    <button type="button" class="scg-preview-button" data-action="preview-card"><i class="fa-solid fa-expand"></i> Agrandir</button>
                    <button type="button" class="scg-compare-card-button {{#if compared}}is-active{{/if}}" data-action="compare-card"><i class="fa-solid fa-scale-balanced"></i> {{#if compared}}Comparée{{else}}Comparer{{/if}}</button>
                    {{#if @root.tradeAvailable}}{{#if tradeAvailableCount}}<button type="button" class="scg-trade-card-button" data-action="trade-card"><i class="fa-solid fa-handshake"></i> Échanger</button>{{else}}<button type="button" class="scg-trade-card-button" disabled title="Tous les exemplaires sont réservés"><i class="fa-solid fa-lock"></i> Réservée</button>{{/if}}{{/if}}
                  </div>
                  <footer>
                    <span>Possédée ×{{ownedCount}}{{#if reservedForTrade}} · {{reservedForTrade}} réservée(s){{/if}}</span>
                    <span>Maximum par deck : {{maxCopies}}</span>
                  </footer>
                </div>
                <div class="scg-card-popover scg-collection-art-popover">
                  {{#if hasArt}}<img src="{{artFull}}" alt="Illustration de {{name}}" loading="lazy" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">{{/if}}
                  <strong>{{name}}</strong>
                  <span>{{rarityLabel}} · {{typeLabel}} · {{factionLabel}} · Force {{strength}}</span>
                  {{#if text}}<p class="scg-card-rules-text" tabindex="0" aria-label="Effet de {{name}} : {{text}}">{{{textHtml}}}</p>{{/if}}
                </div>
              {{else}}
                <div class="scg-hidden-card-back">
                  <span class="scg-hidden-question">?</span>
                  <strong>Carte inconnue</strong>
                  <small>{{id}}</small>
                </div>
              {{/if}}
            </article>
          {{/each}}
        </div>
      </section>
    {{/each}}
  </div>
  <div class="scg-card-preview" data-card-preview hidden><button type="button" data-action="close-preview" aria-label="Fermer">×</button><div><img src="" alt=""><h2></h2><p></p><button type="button" data-action="preview-trade"><i class="fa-solid fa-handshake"></i> Proposer cette carte</button></div></div>

  <div class="scg-card-trade-modal" data-card-trade-modal hidden>
    <form class="scg-card-trade-dialog" data-card-trade-form>
      <header>
        <div>
          <small>Proposition d’échange</small>
          <h2 data-trade-card-name>Carte</h2>
          <p>Vous proposez une carte précise de votre collection. Le joueur destinataire devra confirmer l’échange.</p>
        </div>
        <button type="button" data-action="close-trade" aria-label="Fermer">×</button>
      </header>
      <input type="hidden" name="trade-offered-card" value="">
      <div class="scg-card-trade-grid">
        <label><span>Joueur destinataire</span><select name="trade-user" required><option value="">Choisir un joueur…</option>{{#each tradeUsers}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
        <label><span>Exemplaires proposés</span><input name="trade-offered-count" type="number" min="1" value="1" required></label>
        <label><span>Contrepartie demandée</span><select name="trade-request-mode"><option value="card">Une carte précise</option><option value="rarity">N’importe quelle carte d’une rareté</option><option value="credits">Des tickets de booster</option></select></label>
        <label class="is-wide" data-trade-mode="card"><span>Carte demandée en retour</span><select name="trade-requested"><option value="">Choisir une carte…</option>{{#each tradeCards}}<option value="{{id}}">{{name}} — {{factionLabel}} — {{rarityLabel}}</option>{{/each}}</select></label>
        <label data-trade-mode="card"><span>Exemplaires demandés</span><input name="trade-requested-count" type="number" min="1" value="1"></label>
        <label data-trade-mode="rarity" hidden><span>Rareté demandée</span><select name="trade-requested-rarity"><option value="commun">Commune</option><option value="peuCommune">Peu commune</option><option value="rare" selected>Rare</option><option value="unique">Unique</option></select></label>
        <label data-trade-mode="credits" hidden><span>Tickets demandés</span><input name="trade-requested-credits" type="number" min="1" max="100" value="1"></label>
      </div>
      <p class="scg-card-trade-owned" data-trade-owned-label></p>
      <footer>
        <button type="button" data-action="close-trade">Annuler</button>
        <button type="submit"><i class="fa-solid fa-paper-plane"></i> Envoyer la proposition</button>
      </footer>
    </form>
  </div>
</section>
