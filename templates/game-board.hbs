<section class="scg-shell">
  <header class="scg-toolbar">
    <div class="scg-round-heading">
      <strong>Manche {{round}}</strong>
      <span class="scg-status">{{phaseLabel}}</span>
      <span class="scg-turn">Tour : {{turnLabel}}</span>
    </div>
    <div class="scg-toolbar-actions">
      <button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i> Nouvelle partie</button>
      {{#if canStartNextRound}}
        <button type="button" data-action="next-round"><i class="fa-solid fa-forward"></i> Manche suivante</button>
      {{else}}
        <button type="button" data-action="pass" {{#unless canPlayerAct}}disabled{{/unless}}><i class="fa-solid fa-flag"></i> Passer</button>
      {{/if}}
    </div>
  </header>

  <p class="scg-message">{{message}}</p>

  <div class="scg-scorebar">
    <div class="scg-score-side">
      <span class="scg-muted">{{opponent.name}}</span>
      <strong>{{opponentScore.total}}</strong>
      <span class="scg-control-count">{{opponentControlCount}} ligne(s)</span>
      <span class="scg-lives" title="Couronnes restantes">{{opponent.lifeMarkers}}</span>
    </div>
    <div class="scg-deck-status">
      <span>La manche se gagne en contrôlant le plus de lignes.</span>
      <span>Le total départage les égalités.</span>
    </div>
    <div class="scg-score-side scg-score-side-player">
      <span class="scg-lives" title="Couronnes restantes">{{player.lifeMarkers}}</span>
      <span class="scg-control-count">{{playerControlCount}} ligne(s)</span>
      <strong>{{playerScore.total}}</strong>
      <span class="scg-muted">{{player.name}}</span>
    </div>
  </div>

  {{#if isOpponentTurn}}
    <div class="scg-thinking"><i class="fa-solid fa-hourglass-half"></i> La Maison Aldori cherche une ligne à reprendre…</div>
  {{/if}}

  <div class="scg-battlefield">
    <section class="scg-side scg-opponent {{#if opponent.passed}}is-passed{{/if}}">
      <div class="scg-side-heading">
        <strong>Camp adverse</strong>
        {{#if opponent.passed}}<span class="scg-pass-badge">A passé</span>{{/if}}
      </div>

      <div class="scg-row {{lookup opponentRowClass 'domaine'}}" data-row="domaine">
        <div class="scg-row-label">
          <span>Domaine</span>
          <strong>{{lookup opponentScore.rows "domaine"}}</strong>
          <small class="scg-row-control">{{lookup opponentRowStatus "domaine"}}</small>
        </div>
        <div class="scg-card-line">
          {{#each opponent.rows.domaine}}
            <article class="scg-card">
              <span class="scg-strength">{{effectiveStrength}}</span>
              {{#if isModified}}<span class="scg-base-strength">base {{strength}}</span>{{/if}}
              <strong>{{name}}</strong>
              <div class="scg-role-list">
                {{#each roleBadges}}<span class="scg-role" title="{{description}}">{{label}}</span>{{/each}}
              </div>
            </article>
          {{/each}}
        </div>
      </div>

      <div class="scg-row {{lookup opponentRowClass 'escarmouche'}}" data-row="escarmouche">
        <div class="scg-row-label">
          <span>Escarmouche</span>
          <strong>{{lookup opponentScore.rows "escarmouche"}}</strong>
          <small class="scg-row-control">{{lookup opponentRowStatus "escarmouche"}}</small>
        </div>
        <div class="scg-card-line">
          {{#each opponent.rows.escarmouche}}
            <article class="scg-card">
              <span class="scg-strength">{{effectiveStrength}}</span>
              {{#if isModified}}<span class="scg-base-strength">base {{strength}}</span>{{/if}}
              <strong>{{name}}</strong>
              <div class="scg-role-list">
                {{#each roleBadges}}<span class="scg-role" title="{{description}}">{{label}}</span>{{/each}}
              </div>
            </article>
          {{/each}}
        </div>
      </div>

      <div class="scg-row {{lookup opponentRowClass 'avant-garde'}}" data-row="avant-garde">
        <div class="scg-row-label">
          <span>Avant-garde</span>
          <strong>{{lookup opponentScore.rows "avant-garde"}}</strong>
          <small class="scg-row-control">{{lookup opponentRowStatus "avant-garde"}}</small>
        </div>
        <div class="scg-card-line">
          {{#each opponent.rows.avant-garde}}
            <article class="scg-card">
              <span class="scg-strength">{{effectiveStrength}}</span>
              {{#if isModified}}<span class="scg-base-strength">base {{strength}}</span>{{/if}}
              <strong>{{name}}</strong>
              <div class="scg-role-list">
                {{#each roleBadges}}<span class="scg-role" title="{{description}}">{{label}}</span>{{/each}}
              </div>
            </article>
          {{/each}}
        </div>
      </div>
    </section>

    <div class="scg-divider"></div>

    <section class="scg-side scg-player {{#if player.passed}}is-passed{{/if}}">
      <div class="scg-side-heading">
        <strong>Votre camp</strong>
        {{#if player.passed}}<span class="scg-pass-badge">Vous avez passé</span>{{/if}}
      </div>

      <div class="scg-row {{lookup playerRowClass 'avant-garde'}}" data-row="avant-garde">
        <div class="scg-row-label">
          <span>Avant-garde</span>
          <strong>{{lookup playerScore.rows "avant-garde"}}</strong>
          <small class="scg-row-control">{{lookup playerRowStatus "avant-garde"}}</small>
        </div>
        <div class="scg-card-line">
          {{#each player.rows.avant-garde}}
            <article class="scg-card">
              <span class="scg-strength">{{effectiveStrength}}</span>
              {{#if isModified}}<span class="scg-base-strength">base {{strength}}</span>{{/if}}
              <strong>{{name}}</strong>
              <div class="scg-role-list">
                {{#each roleBadges}}<span class="scg-role" title="{{description}}">{{label}}</span>{{/each}}
              </div>
            </article>
          {{/each}}
        </div>
      </div>

      <div class="scg-row {{lookup playerRowClass 'escarmouche'}}" data-row="escarmouche">
        <div class="scg-row-label">
          <span>Escarmouche</span>
          <strong>{{lookup playerScore.rows "escarmouche"}}</strong>
          <small class="scg-row-control">{{lookup playerRowStatus "escarmouche"}}</small>
        </div>
        <div class="scg-card-line">
          {{#each player.rows.escarmouche}}
            <article class="scg-card">
              <span class="scg-strength">{{effectiveStrength}}</span>
              {{#if isModified}}<span class="scg-base-strength">base {{strength}}</span>{{/if}}
              <strong>{{name}}</strong>
              <div class="scg-role-list">
                {{#each roleBadges}}<span class="scg-role" title="{{description}}">{{label}}</span>{{/each}}
              </div>
            </article>
          {{/each}}
        </div>
      </div>

      <div class="scg-row {{lookup playerRowClass 'domaine'}}" data-row="domaine">
        <div class="scg-row-label">
          <span>Domaine</span>
          <strong>{{lookup playerScore.rows "domaine"}}</strong>
          <small class="scg-row-control">{{lookup playerRowStatus "domaine"}}</small>
        </div>
        <div class="scg-card-line">
          {{#each player.rows.domaine}}
            <article class="scg-card">
              <span class="scg-strength">{{effectiveStrength}}</span>
              {{#if isModified}}<span class="scg-base-strength">base {{strength}}</span>{{/if}}
              <strong>{{name}}</strong>
              <div class="scg-role-list">
                {{#each roleBadges}}<span class="scg-role" title="{{description}}">{{label}}</span>{{/each}}
              </div>
            </article>
          {{/each}}
        </div>
      </div>
    </section>
  </div>

  <section class="scg-hand {{#unless canPlayerAct}}is-locked{{/unless}}">
    <div class="scg-side-heading">
      <strong>Votre main</strong>
      <span>{{player.hand.length}} cartes · Pioche {{player.deck.length}} · Défausse {{player.discard.length}}</span>
    </div>
    <div class="scg-hand-grid">
      {{#each player.hand}}
        <article class="scg-card scg-hand-card">
          <span class="scg-strength">{{strength}}</span>
          <strong>{{name}}</strong>
          <div class="scg-role-list">
            {{#each roleBadges}}<span class="scg-role" title="{{description}}">{{label}}</span>{{/each}}
          </div>
          <small>{{#each rowChoices}}{{label}}{{#unless @last}} · {{/unless}}{{/each}}</small>
          <div class="scg-play-actions">
            {{#each rowChoices}}
              <button type="button" data-action="play-card" data-card-id="{{../id}}" data-row="{{id}}" {{#unless @root.canPlayerAct}}disabled{{/unless}}>{{label}}</button>
            {{/each}}
          </div>
        </article>
      {{/each}}
    </div>
  </section>
</section>
