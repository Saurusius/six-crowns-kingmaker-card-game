<section class="scg-shell {{#if rulesOpen}}is-rules-open{{/if}}">
  <header class="scg-toolbar">
    <div class="scg-round-heading">
      <strong>{{#if round}}Manche {{round}}{{else}}Nouvelle partie{{/if}}</strong>
      <span class="scg-status">{{phaseLabel}}</span>
      {{#if showBoard}}<span class="scg-turn">Tour : {{turnLabel}}</span>{{/if}}
    </div>
    <div class="scg-toolbar-actions">
      <button type="button" data-action="toggle-rules"><i class="fa-solid fa-scroll"></i> Règlement</button>
      <button type="button" data-action="open-glossary"><i class="fa-solid fa-book-open"></i> Glossaire</button>
      {{#if isGM}}<button type="button" data-action="open-analytics"><i class="fa-solid fa-chart-line"></i> Équilibrage</button>{{/if}}
      <button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i> Nouvelle partie</button>
      {{#if canRematch}}
        <button type="button" class="scg-primary-button" data-action="rematch"><i class="fa-solid fa-arrows-rotate"></i> Revanche</button>
      {{else}}{{#if canStartNextRound}}
        <button type="button" data-action="next-round"><i class="fa-solid fa-forward"></i> Manche suivante</button>
      {{else}}
        {{#if showBoard}}<button type="button" data-action="pass" {{#unless canPlayerAct}}disabled{{/unless}}><i class="fa-solid fa-flag"></i> Passer</button>{{/if}}
      {{/if}}{{/if}}
    </div>
  </header>

  <p class="scg-message">{{message}}</p>

  {{#if rulesOpen}}
    <section class="scg-rulebook-panel">
      <div class="scg-rulebook-header">
        <div>
          <h2>Règlement du Jeu des Six Couronnes</h2>
          <p>Rappel rapide des effets, du déroulement d’une manche et des conditions de victoire.</p>
        </div>
        <button type="button" class="scg-rulebook-close" data-action="toggle-rules"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="scg-rulebook-grid">
        {{#each ruleSections}}
          <article class="scg-rulebook-card">
            <h3>{{title}}</h3>
            <ul>
              {{#each items}}<li>{{this}}</li>{{/each}}
            </ul>
          </article>
        {{/each}}
      </div>
    </section>
  {{/if}}

  {{#if isDeckSelection}}
    <section class="scg-setup-panel">
      <div class="scg-setup-heading">
        <h2>Choisissez les decks</h2>
        <p>Les decks prédéfinis sont des decks de démonstration de 20 cartes, indépendants de votre collection personnelle.</p><p><strong>Construction :</strong> un deck contient exactement 20 cartes. Pour une même carte : 3 exemplaires maximum si elle est Commune ou Peu commune, 2 si elle est Rare et 1 si elle est Unique.</p><p>Il n’existe pas de plafond global de cartes Uniques différentes. Les joueurs peuvent échanger leurs cartes et recycler 10 exemplaires contre 1 ticket de booster.</p>
      </div>

      <div class="scg-deck-select-grid">
        <label class="scg-deck-select">
          <span>Votre deck</span>
          <select name="player-deck">
            <option value="random" {{#if playerDeckIsRandom}}selected{{/if}}>Deck aléatoire</option>
            {{#each decks}}
              <option value="{{id}}" {{#if playerSelected}}selected{{/if}}>{{name}} — {{cardCount}} cartes</option>
            {{/each}}
          </select>
        </label>

        <label class="scg-deck-select">
          <span>Deck adverse</span>
          <select name="opponent-deck">
            <option value="random" {{#if opponentDeckIsRandom}}selected{{/if}}>Deck aléatoire</option>
            {{#each decks}}
              <option value="{{id}}" {{#if opponentSelected}}selected{{/if}}>{{name}} — {{cardCount}} cartes</option>
            {{/each}}
          </select>
        </label>
      </div>

      <div class="scg-deck-gallery">
        {{#each decks}}
          <article class="scg-deck-summary {{#if custom}}is-custom scg-deck-custom{{else}}scg-deck-{{id}}{{/if}}">
            <span class="scg-deck-symbol">{{symbol}}</span>
            <div>
              <strong>{{name}}</strong>
              <small>{{cardCount}} cartes{{#if demo}} · Démonstration{{/if}}</small>
              <p>{{description}}</p>
            </div>
          </article>
        {{/each}}
      </div>

      <div class="scg-setup-actions">
        <button class="scg-secondary-button" type="button" data-action="open-booster" {{#unless canOpenBooster}}disabled{{/unless}}>
          <i class="fa-solid fa-box-open"></i> {{boosterButtonLabel}}
        </button>
        <button class="scg-secondary-button" type="button" data-action="open-collection">
          <i class="fa-solid fa-table-cells-large"></i> Ma collection
        </button>
        <button class="scg-secondary-button" type="button" data-action="open-deck-builder">
          <i class="fa-solid fa-hammer"></i> Mes decks
        </button>
        <button class="scg-primary-button" type="button" data-action="start-game">
          <i class="fa-solid fa-play"></i> Préparer la partie
        </button>
      </div>
    </section>
  {{/if}}

  {{#if isCoinToss}}
    <section class="scg-coin-panel">
      <div class="scg-versus">
        <span>{{player.name}}</span>
        <strong>contre</strong>
        <span>{{opponent.name}}</span>
      </div>

      <div class="scg-coin-stage">
        <div class="scg-coin {{coinClass}}" aria-label="Pièce de tirage au sort">
          <div class="scg-coin-face scg-coin-front"><i class="fa-solid fa-shield-halved"></i></div>
          <div class="scg-coin-face scg-coin-back"><i class="fa-solid fa-sword"></i></div>
        </div>
        {{#if coin.resolved}}<strong class="scg-coin-result"><i class="{{coinFaceIcon}}"></i> {{coinFaceLabel}}</strong>{{/if}}
      </div>

      {{#if coin.resolved}}
        <div class="scg-coin-summary {{#if coinPlayerWon}}is-win{{else}}is-loss{{/if}}">
          Votre choix : <strong><i class="{{coinChoiceIcon}}"></i> {{coinChoiceLabel}}</strong> · Résultat : <strong><i class="{{coinFaceIcon}}"></i> {{coinFaceLabel}}</strong>
        </div>
        <button class="scg-primary-button" type="button" data-action="continue-after-coin">Voir les mains</button>
      {{else}}
        {{#if coin.flipping}}
          <div class="scg-coin-summary">Votre choix : <strong><i class="{{coinChoiceIcon}}"></i> {{coinChoiceLabel}}</strong></div>
          <button class="scg-primary-button" type="button" disabled><i class="fa-solid fa-coins"></i> La pièce tourne…</button>
        {{else}}
          <div class="scg-coin-choice" role="group" aria-label="Choisissez Bouclier ou Épée">
            <button class="scg-choice-button" type="button" data-action="flip-coin" data-choice="shield">
              <span class="scg-choice-symbol"><i class="fa-solid fa-shield-halved"></i></span><strong>Bouclier</strong>
            </button>
            <button class="scg-choice-button" type="button" data-action="flip-coin" data-choice="sword">
              <span class="scg-choice-symbol"><i class="fa-solid fa-sword"></i></span><strong>Épée</strong>
            </button>
          </div>
        {{/if}}
      {{/if}}
    </section>
  {{/if}}

  {{#if isMulligan}}
    <section class="scg-mulligan-panel">
      <div class="scg-setup-heading">
        <h2>Votre main de départ</h2>
        <p>Sélectionnez jusqu’à deux cartes à remplacer. Sélection : {{mulliganSelectedCount}} / 2.</p>
      </div>

      <div class="scg-mulligan-grid">
        {{#each player.hand}}
          <article class="scg-mulligan-card-wrap" data-mulligan-card-id="{{id}}">
            <button type="button" class="scg-card scg-detail-card scg-mulligan-card {{factionClass}} {{#if mulliganSelected}}is-selected{{/if}}" data-action="toggle-mulligan" data-card-id="{{id}}">
              <span class="scg-card-art">
                {{#if hasImage}}
                  <img src="{{artMedium}}" alt="Illustration de {{name}}" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">
                {{else}}
                  <span class="scg-card-placeholder"><span>{{factionSymbol}}</span><small>{{factionLabel}}</small></span>
                {{/if}}
                <span class="scg-strength">{{strength}}</span>
                <span class="scg-rarity-badge {{rarityClass}}" title="Rareté : {{rarityLabel}}"><i class="{{rarityIcon}}"></i></span>
                <span class="scg-row-emblem" title="{{rowSummary}}"><i class="{{primaryRowIcon}}"></i></span>
              </span>
              <span class="scg-card-body">
                <strong class="scg-card-name">{{name}}</strong>
                <span class="scg-effect-icons">
                  {{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}
                </span>
                <span class="scg-mulligan-mark">{{#if mulliganSelected}}À remplacer{{else}}Conserver{{/if}}</span>
              </span>
            </button>
            <button
              type="button"
              class="scg-mulligan-preview-trigger"
              data-action="preview-mulligan"
              data-card-id="{{id}}"
              title="Prévisualiser {{name}}"
              aria-label="Prévisualiser {{name}}"
            ><i class="fa-solid fa-magnifying-glass-plus"></i></button>
          </article>
        {{/each}}
      </div>

      <div class="scg-mulligan-preview-backdrop" data-mulligan-preview hidden tabindex="-1" aria-hidden="true">
        <div class="scg-mulligan-preview-dialog" role="dialog" aria-modal="true" aria-label="Prévisualisation de la carte">
          <button type="button" class="scg-mulligan-preview-close" data-action="close-mulligan-preview" title="Fermer la prévisualisation" aria-label="Fermer la prévisualisation"><i class="fa-solid fa-xmark"></i></button>
          {{#each player.hand}}
            <article class="scg-card scg-mulligan-preview-card {{factionClass}} {{rarityClass}}" data-preview-card-id="{{id}}" hidden>
              <div class="scg-mulligan-preview-art">
                {{#if hasImage}}
                  <img src="{{artFull}}" alt="Illustration de {{name}}" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">
                {{else}}
                  <span class="scg-card-placeholder"><span>{{factionSymbol}}</span><small>{{factionLabel}}</small></span>
                {{/if}}
                <span class="scg-strength">{{strength}}</span>
                <span class="scg-rarity-badge {{rarityClass}}" title="Rareté : {{rarityLabel}}"><i class="{{rarityIcon}}"></i></span>
                <span class="scg-row-emblem" title="{{rowSummary}}"><i class="{{primaryRowIcon}}"></i></span>
              </div>
              <div class="scg-mulligan-preview-body">
                <span class="scg-rarity-line {{rarityClass}}"><i class="{{rarityIcon}}"></i> {{rarityLabel}}</span>
                <h3>{{name}}</h3>
                <p class="scg-mulligan-preview-meta"><strong>Ligne(s) :</strong> {{rowSummary}} · <strong>Force :</strong> {{strength}}</p>
                <div class="scg-mulligan-preview-traits">
                  {{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}
                </div>
                <p class="scg-mulligan-preview-effect">{{effectText}}</p>
              </div>
            </article>
          {{/each}}
        </div>
      </div>

      <div class="scg-mulligan-footer">
        <span>Pioche restante : {{player.deck.length}} · Défausse : {{player.discard.length}}</span>
        <button class="scg-primary-button" type="button" data-action="confirm-mulligan">{{mulliganButtonLabel}}</button>
      </div>
    </section>
  {{/if}}

  {{#if showBoard}}
    <div class="scg-scorebar">
      <div class="scg-score-side">
        <span class="scg-muted">{{opponent.name}}</span>
        <strong>{{opponentScore.total}}</strong>
        <span class="scg-line-count">{{opponent.controlledLines}} ligne(s)</span>
        <span class="scg-gems" title="Points de manche restants">
          {{#each opponent.gems}}<span class="scg-gem {{#if active}}is-active{{else}}is-empty{{/if}}"></span>{{/each}}
        </span>
      </div>
      <div class="scg-deck-status">
        <span>La manche se gagne d’abord au contrôle des lignes, puis au total.</span>
        <span>Le bouton <strong>Règlement</strong> reste disponible pendant toute la partie.</span>
      </div>
      <div class="scg-score-side scg-score-side-player">
        <span class="scg-gems" title="Points de manche restants">
          {{#each player.gems}}<span class="scg-gem {{#if active}}is-active{{else}}is-empty{{/if}}"></span>{{/each}}
        </span>
        <strong>{{playerScore.total}}</strong>
        <span class="scg-line-count">{{player.controlledLines}} ligne(s)</span>
        <span class="scg-muted">{{player.name}}</span>
      </div>
    </div>

    {{#if gameSummary}}
      <section class="scg-game-summary"><div><small>Partie terminée</small><h2>{{gameSummary.winnerLabel}}</h2><p>{{message}}</p></div><div><article><strong>{{gameSummary.rounds}}</strong><span>manches</span></article><article><strong>{{gameSummary.playerCardsPlayed}}</strong><span>cartes jouées</span></article><article><strong>{{gameSummary.opponentCardsPlayed}}</strong><span>cartes adverses</span></article></div><button type="button" data-action="rematch"><i class="fa-solid fa-arrows-rotate"></i> Relancer les mêmes decks</button></section>
    {{/if}}

    {{#if isOpponentTurn}}
      <div class="scg-thinking"><i class="fa-solid fa-hourglass-half"></i> {{opponent.name}} réfléchit…</div>
    {{/if}}

    <section class="scg-board-layout">
      <aside class="scg-hand-sidebar {{#unless canPlayerAct}}is-locked{{/unless}}">
        <div class="scg-side-mini scg-side-mini-opponent">
          <strong>{{opponent.name}}</strong>
          <span>{{opponent.handCount}} cartes en main</span>
          {{#if opponent.passed}}<span class="scg-pass-badge">A passé</span>{{/if}}
        </div>

        <div class="scg-hand-panel">
          <div class="scg-side-heading">
            <strong>Votre main</strong>
            <span>{{player.hand.length}} cartes à jouer</span>
          </div>
          <div class="scg-hand-column">
            {{#each player.hand}}
              <article class="scg-card scg-hand-card {{factionClass}} {{rarityClass}}">
                <div class="scg-hand-card-top">
                  <div class="scg-hand-card-art">
                    {{#if hasImage}}
                      <img src="{{artMedium}}" alt="Illustration de {{name}}" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">
                    {{else}}
                      <span class="scg-card-placeholder"><span>{{factionSymbol}}</span></span>
                    {{/if}}
                    <span class="scg-strength">{{strength}}</span>
                  </div>
                  <div class="scg-hand-card-info">
                    <strong class="scg-card-name">{{name}}</strong>
                    <span class="scg-rarity-line {{rarityClass}}"><i class="{{rarityIcon}}"></i> {{rarityLabel}}</span>
                    <div class="scg-effect-icons">{{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}</div>
                  </div>
                </div>
                <div class="scg-play-actions">
                  {{#each rowChoices}}
                    <button type="button" title="Jouer sur {{label}}" data-action="play-card" data-card-id="{{../id}}" data-row="{{id}}" {{#unless @root.canPlayerAct}}disabled{{/unless}}><i class="{{icon}}"></i> {{label}}</button>
                  {{/each}}
                </div>
                <div class="scg-card-popover scg-hand-popover">
                  <strong>{{name}}</strong>
                  <span>{{rarityLabel}} · {{rowSummary}} · Force {{strength}}</span>
                  <p>{{effectText}}</p>
                </div>
              </article>
            {{/each}}
          </div>
        </div>

        <div class="scg-side-mini scg-side-mini-player">
          <strong>{{player.name}}</strong>
          <span>Pioche {{player.deck.length}} · Défausse {{player.discard.length}}</span>
          {{#if player.passed}}<span class="scg-pass-badge">Vous avez passé</span>{{/if}}
        </div>
      </aside>

      <div class="scg-battlefield-panel">
        <section class="scg-side scg-opponent {{#if opponent.passed}}is-passed{{/if}}">
          {{#each opponent.rowList}}
            <div class="scg-row" data-row="{{id}}">
              <div class="scg-row-label {{status.className}}">
                <span class="scg-row-icon"><i class="{{icon}}"></i></span>
                <span>{{label}}</span>
                <strong>{{score}}</strong>
                <small class="scg-row-control">{{status.label}}</small>
              </div>
              <div class="scg-card-line">
                {{#each cards}}
                  <article class="scg-card scg-board-card {{factionClass}} {{rarityClass}}">
                    <div class="scg-card-art">
                      {{#if hasImage}}
                        <img src="{{artThumb}}" alt="Illustration de {{name}}" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">
                      {{else}}
                        <span class="scg-card-placeholder"><span>{{factionSymbol}}</span></span>
                      {{/if}}
                      <span class="scg-strength">{{effectiveStrength}}</span>
                      <span class="scg-rarity-dot {{rarityClass}}" title="{{rarityLabel}}"></span>
                      {{#if isModified}}<span class="scg-base-strength">{{strength}}</span>{{/if}}
                      <span class="scg-row-emblem" title="{{rowSummary}}"><i class="{{primaryRowIcon}}"></i></span>
                    </div>
                    <div class="scg-card-caption">
                      <strong>{{name}}</strong>
                      <span class="scg-effect-icons">{{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}</span>
                    </div>
                    <div class="scg-card-popover">
                      <strong>{{name}}</strong>
                      <span>{{rarityLabel}} · {{rowSummary}} · Force {{effectiveStrength}}{{#if isModified}} (base {{strength}}){{/if}}</span>
                      <p>{{effectText}}</p>
                    </div>
                  </article>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </section>

        <div class="scg-divider"></div>

        <section class="scg-side scg-player {{#if player.passed}}is-passed{{/if}}">
          {{#each player.rowList}}
            <div class="scg-row" data-row="{{id}}">
              <div class="scg-row-label {{status.className}}">
                <span class="scg-row-icon"><i class="{{icon}}"></i></span>
                <span>{{label}}</span>
                <strong>{{score}}</strong>
                <small class="scg-row-control">{{status.label}}</small>
              </div>
              <div class="scg-card-line">
                {{#each cards}}
                  <article class="scg-card scg-board-card {{factionClass}} {{rarityClass}}">
                    <div class="scg-card-art">
                      {{#if hasImage}}
                        <img src="{{artThumb}}" alt="Illustration de {{name}}" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">
                      {{else}}
                        <span class="scg-card-placeholder"><span>{{factionSymbol}}</span></span>
                      {{/if}}
                      <span class="scg-strength">{{effectiveStrength}}</span>
                      <span class="scg-rarity-dot {{rarityClass}}" title="{{rarityLabel}}"></span>
                      {{#if isModified}}<span class="scg-base-strength">{{strength}}</span>{{/if}}
                      <span class="scg-row-emblem" title="{{rowSummary}}"><i class="{{primaryRowIcon}}"></i></span>
                    </div>
                    <div class="scg-card-caption">
                      <strong>{{name}}</strong>
                      <span class="scg-effect-icons">{{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}</span>
                    </div>
                    <div class="scg-card-popover">
                      <strong>{{name}}</strong>
                      <span>{{rarityLabel}} · {{rowSummary}} · Force {{effectiveStrength}}{{#if isModified}} (base {{strength}}){{/if}}</span>
                      <p>{{effectText}}</p>
                    </div>
                  </article>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </section>
      </div>

      <aside class="scg-reserve-sidebar">
        <div class="scg-zone-stack scg-zone-stack-opponent">
          <article class="scg-duelist-profile scg-duelist-profile-opponent">
            <img src="{{opponentProfile.image}}" alt="Portrait de {{opponentProfile.name}}">
            <div><small>Adversaire</small><strong>{{opponentProfile.name}}</strong></div>
          </article>
          <article class="scg-zone-card scg-zone-card-deck">
            <div class="scg-zone-visual"><span><i class="fa-solid fa-layer-group"></i></span></div>
            <strong>Deck adverse</strong>
            <small>{{opponent.deck.length}} carte(s)</small>
          </article>
          <article class="scg-zone-card scg-zone-card-discard">
            <div class="scg-zone-visual is-discard"><span><i class="fa-solid fa-skull"></i></span></div>
            <strong>Défausse adverse</strong>
            <small>{{opponent.discard.length}} carte(s)</small>
          </article>
        </div>

        <div class="scg-turn-card">
          <strong>{{#if isOpponentTurn}}Tour adverse{{else}}État de la manche{{/if}}</strong>
          <p>{{message}}</p>
          <div class="scg-turn-meta">
            <span><i class="fa-solid fa-shield-halved"></i> {{opponent.controlledLines}} ligne(s) adverses</span>
            <span><i class="fa-solid fa-sword"></i> {{player.controlledLines}} ligne(s) alliées</span>
          </div>
        </div>

        {{#if hasActionLog}}<details class="scg-match-log"><summary><i class="fa-solid fa-list"></i> Journal de partie <b>{{actionLog.length}}</b></summary><div>{{#each actionLog}}<article class="is-{{type}}"><small>Manche {{round}}</small><span>{{message}}</span></article>{{/each}}</div></details>{{/if}}

        <div class="scg-zone-stack scg-zone-stack-player">
          <article class="scg-duelist-profile scg-duelist-profile-player">
            <img src="{{playerProfile.image}}" alt="Portrait de {{playerProfile.name}}">
            <div><small>Votre personnage</small><strong>{{playerProfile.name}}</strong></div>
          </article>
          <article class="scg-zone-card scg-zone-card-deck">
            <div class="scg-zone-visual"><span><i class="fa-solid fa-layer-group"></i></span></div>
            <strong>Votre deck</strong>
            <small>{{player.deck.length}} carte(s)</small>
          </article>
          <article class="scg-zone-card scg-zone-card-discard">
            <div class="scg-zone-visual is-discard"><span><i class="fa-solid fa-fire"></i></span></div>
            <strong>Votre défausse</strong>
            <small>{{player.discard.length}} carte(s)</small>
          </article>
        </div>
      </aside>
    </section>
  {{/if}}
</section>
