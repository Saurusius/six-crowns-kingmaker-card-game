<section class="scg-shell">
  <header class="scg-toolbar">
    <div class="scg-round-heading">
      <strong>{{#if round}}Manche {{round}}{{else}}Nouvelle partie{{/if}}</strong>
      <span class="scg-status">{{phaseLabel}}</span>
      {{#if showBoard}}<span class="scg-turn">Tour : {{turnLabel}}</span>{{/if}}
    </div>
    <div class="scg-toolbar-actions">
      <button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i> Nouvelle partie</button>
      {{#if canStartNextRound}}
        <button type="button" data-action="next-round"><i class="fa-solid fa-forward"></i> Manche suivante</button>
      {{else}}
        {{#if showBoard}}
          <button type="button" data-action="pass" {{#unless canPlayerAct}}disabled{{/unless}}><i class="fa-solid fa-flag"></i> Passer</button>
        {{/if}}
      {{/if}}
    </div>
  </header>

  <p class="scg-message">{{message}}</p>

  {{#if isDeckSelection}}
    <section class="scg-setup-panel">
      <div class="scg-setup-heading">
        <h2>Choisissez les decks</h2>
        <p>Chaque deck est prédéfini et contient au maximum 20 cartes.</p>
      </div>

      <div class="scg-deck-select-grid">
        <label class="scg-deck-select">
          <span>Votre deck</span>
          <select name="player-deck">
            {{#each decks}}
              <option value="{{id}}" {{#if playerSelected}}selected{{/if}}>{{name}} — {{cardCount}} cartes</option>
            {{/each}}
          </select>
        </label>

        <label class="scg-deck-select">
          <span>Deck adverse</span>
          <select name="opponent-deck">
            {{#each decks}}
              <option value="{{id}}" {{#if opponentSelected}}selected{{/if}}>{{name}} — {{cardCount}} cartes</option>
            {{/each}}
          </select>
        </label>
      </div>

      <div class="scg-deck-gallery">
        {{#each decks}}
          <article class="scg-deck-summary scg-deck-{{id}}">
            <span class="scg-deck-symbol">{{symbol}}</span>
            <div>
              <strong>{{name}}</strong>
              <small>{{cardCount}} cartes</small>
              <p>{{description}}</p>
            </div>
          </article>
        {{/each}}
      </div>

      <button class="scg-primary-button" type="button" data-action="start-game">
        <i class="fa-solid fa-play"></i> Préparer la partie
      </button>
    </section>
  {{/if}}

  {{#if isCoinToss}}
    <section class="scg-coin-panel">
      <div class="scg-versus">
        <span>{{player.name}}</span>
        <strong>contre</strong>
        <span>{{opponent.name}}</span>
      </div>

      <div class="scg-coin-stage">
        <div class="scg-coin {{coinClass}}" aria-label="Pièce de tirage au sort">
          <div class="scg-coin-face scg-coin-front">6</div>
          <div class="scg-coin-face scg-coin-back">♛</div>
        </div>
        {{#if coin.resolved}}<strong class="scg-coin-result">{{coinFaceLabel}}</strong>{{/if}}
      </div>

      {{#if coin.resolved}}
        <div class="scg-coin-summary {{#if coinPlayerWon}}is-win{{else}}is-loss{{/if}}">
          Votre choix : <strong>{{coinChoiceLabel}}</strong> · Résultat : <strong>{{coinFaceLabel}}</strong>
        </div>
        <button class="scg-primary-button" type="button" data-action="continue-after-coin">Voir les mains</button>
      {{else}}
        {{#if coin.flipping}}
          <div class="scg-coin-summary">Votre choix : <strong>{{coinChoiceLabel}}</strong></div>
          <button class="scg-primary-button" type="button" disabled><i class="fa-solid fa-coins"></i> La pièce tourne…</button>
        {{else}}
          <div class="scg-coin-choice" role="group" aria-label="Choisissez pile ou face">
            <button class="scg-choice-button" type="button" data-action="flip-coin" data-choice="pile">
              <span class="scg-choice-symbol">♛</span><strong>Pile</strong>
            </button>
            <button class="scg-choice-button" type="button" data-action="flip-coin" data-choice="face">
              <span class="scg-choice-symbol">6</span><strong>Face</strong>
            </button>
          </div>
        {{/if}}
      {{/if}}
    </section>
  {{/if}}

  {{#if isMulligan}}
    <section class="scg-mulligan-panel">
      <div class="scg-setup-heading">
        <h2>Votre main de départ</h2>
        <p>Sélectionnez jusqu’à deux cartes à remplacer. Sélection : {{mulliganSelectedCount}} / 2.</p>
      </div>

      <div class="scg-mulligan-grid">
        {{#each player.hand}}
          <button type="button" class="scg-card scg-detail-card scg-mulligan-card {{factionClass}} {{#if mulliganSelected}}is-selected{{/if}}" data-action="toggle-mulligan" data-card-id="{{id}}">
            <span class="scg-card-art">
              {{#if hasImage}}
                <img src="{{image}}" alt="Illustration de {{name}}">
              {{else}}
                <span class="scg-card-placeholder"><span>{{factionSymbol}}</span><small>{{factionLabel}}</small></span>
              {{/if}}
              <span class="scg-strength">{{strength}}</span>
              <span class="scg-row-emblem" title="{{rowSummary}}"><i class="{{primaryRowIcon}}"></i></span>
            </span>
            <span class="scg-card-body">
              <strong class="scg-card-name">{{name}}</strong>
              <span class="scg-effect-icons">
                {{#each roleBadges}}<span title="{{label}} — {{description}}"><i class="{{icon}}"></i></span>{{/each}}
              </span>
              <small class="scg-card-effect">{{effectText}}</small>
              <span class="scg-mulligan-mark">{{#if mulliganSelected}}À remplacer{{else}}Conserver{{/if}}</span>
            </span>
          </button>
        {{/each}}
      </div>

      <div class="scg-mulligan-footer">
        <span>Pioche restante : {{player.deck.length}} · Défausse : {{player.discard.length}}</span>
        <button class="scg-primary-button" type="button" data-action="confirm-mulligan">{{mulliganButtonLabel}}</button>
      </div>
    </section>
  {{/if}}

  {{#if showBoard}}
    <div class="scg-scorebar">
      <div class="scg-score-side">
        <span class="scg-muted">{{opponent.name}}</span>
        <strong>{{opponentScore.total}}</strong>
        <span class="scg-line-count">{{opponent.controlledLines}} ligne(s)</span>
        <span class="scg-gems" title="Points de manche restants">
          {{#each opponent.gems}}<span class="scg-gem {{#if active}}is-active{{else}}is-empty{{/if}}"></span>{{/each}}
        </span>
      </div>
      <div class="scg-deck-status">
        <span>Le contrôle des lignes remporte la manche.</span>
        <span>Survolez une carte du plateau pour lire son effet.</span>
      </div>
      <div class="scg-score-side scg-score-side-player">
        <span class="scg-gems" title="Points de manche restants">
          {{#each player.gems}}<span class="scg-gem {{#if active}}is-active{{else}}is-empty{{/if}}"></span>{{/each}}
        </span>
        <strong>{{playerScore.total}}</strong>
        <span class="scg-line-count">{{player.controlledLines}} ligne(s)</span>
        <span class="scg-muted">{{player.name}}</span>
      </div>
    </div>

    {{#if isOpponentTurn}}
      <div class="scg-thinking"><i class="fa-solid fa-hourglass-half"></i> {{opponent.name}} réfléchit…</div>
    {{/if}}

    <div class="scg-battlefield">
      <section class="scg-side scg-opponent {{#if opponent.passed}}is-passed{{/if}}">
        <div class="scg-side-heading">
          <strong>Camp adverse</strong>
          <span>{{opponent.handCount}} cartes en main · Pioche {{opponent.deck.length}} · Défausse {{opponent.discard.length}}</span>
          {{#if opponent.passed}}<span class="scg-pass-badge">A passé</span>{{/if}}
        </div>

        {{#each opponent.rowList}}
          <div class="scg-row" data-row="{{id}}">
            <div class="scg-row-label {{status.className}}">
              <span>{{label}}</span>
              <strong>{{score}}</strong>
              <small class="scg-row-control">{{status.label}}</small>
            </div>
            <div class="scg-card-line">
              {{#each cards}}
                <article class="scg-card scg-board-card {{factionClass}}">
                  <div class="scg-card-art">
                    {{#if hasImage}}
                      <img src="{{image}}" alt="Illustration de {{name}}">
                    {{else}}
                      <span class="scg-card-placeholder"><span>{{factionSymbol}}</span></span>
                    {{/if}}
                    <span class="scg-strength">{{effectiveStrength}}</span>
                    {{#if isModified}}<span class="scg-base-strength">{{strength}}</span>{{/if}}
                    <span class="scg-row-emblem" title="{{rowSummary}}"><i class="{{primaryRowIcon}}"></i></span>
                  </div>
                  <div class="scg-card-caption">
                    <strong>{{name}}</strong>
                    <span class="scg-effect-icons">{{#each roleBadges}}<span title="{{label}} — {{description}}"><i class="{{icon}}"></i></span>{{/each}}</span>
                  </div>
                  <div class="scg-card-popover">
                    <strong>{{name}}</strong>
                    <span>{{rowSummary}} · Force {{effectiveStrength}}{{#if isModified}} (base {{strength}}){{/if}}</span>
                    <p>{{effectText}}</p>
                  </div>
                </article>
              {{/each}}
            </div>
          </div>
        {{/each}}
      </section>

      <div class="scg-divider"></div>

      <section class="scg-side scg-player {{#if player.passed}}is-passed{{/if}}">
        <div class="scg-side-heading">
          <strong>Votre camp</strong>
          <span>{{player.hand.length}} cartes en main · Pioche {{player.deck.length}} · Défausse {{player.discard.length}}</span>
          {{#if player.passed}}<span class="scg-pass-badge">Vous avez passé</span>{{/if}}
        </div>

        {{#each player.rowList}}
          <div class="scg-row" data-row="{{id}}">
            <div class="scg-row-label {{status.className}}">
              <span>{{label}}</span>
              <strong>{{score}}</strong>
              <small class="scg-row-control">{{status.label}}</small>
            </div>
            <div class="scg-card-line">
              {{#each cards}}
                <article class="scg-card scg-board-card {{factionClass}}">
                  <div class="scg-card-art">
                    {{#if hasImage}}
                      <img src="{{image}}" alt="Illustration de {{name}}">
                    {{else}}
                      <span class="scg-card-placeholder"><span>{{factionSymbol}}</span></span>
                    {{/if}}
                    <span class="scg-strength">{{effectiveStrength}}</span>
                    {{#if isModified}}<span class="scg-base-strength">{{strength}}</span>{{/if}}
                    <span class="scg-row-emblem" title="{{rowSummary}}"><i class="{{primaryRowIcon}}"></i></span>
                  </div>
                  <div class="scg-card-caption">
                    <strong>{{name}}</strong>
                    <span class="scg-effect-icons">{{#each roleBadges}}<span title="{{label}} — {{description}}"><i class="{{icon}}"></i></span>{{/each}}</span>
                  </div>
                  <div class="scg-card-popover">
                    <strong>{{name}}</strong>
                    <span>{{rowSummary}} · Force {{effectiveStrength}}{{#if isModified}} (base {{strength}}){{/if}}</span>
                    <p>{{effectText}}</p>
                  </div>
                </article>
              {{/each}}
            </div>
          </div>
        {{/each}}
      </section>
    </div>

    <section class="scg-hand {{#unless canPlayerAct}}is-locked{{/unless}}">
      <div class="scg-side-heading">
        <strong>Votre main</strong>
        <span>{{player.hand.length}} cartes · Illustration, force, ligne et effet restent visibles.</span>
      </div>
      <div class="scg-hand-grid">
        {{#each player.hand}}
          <article class="scg-card scg-detail-card scg-hand-card {{factionClass}}">
            <div class="scg-card-art">
              {{#if hasImage}}
                <img src="{{image}}" alt="Illustration de {{name}}">
              {{else}}
                <span class="scg-card-placeholder"><span>{{factionSymbol}}</span><small>{{factionLabel}}</small></span>
              {{/if}}
              <span class="scg-strength">{{strength}}</span>
              <span class="scg-row-emblem" title="{{rowSummary}}"><i class="{{primaryRowIcon}}"></i></span>
            </div>
            <div class="scg-card-body">
              <strong class="scg-card-name">{{name}}</strong>
              <div class="scg-effect-icons">{{#each roleBadges}}<span title="{{label}} — {{description}}"><i class="{{icon}}"></i></span>{{/each}}</div>
              <small class="scg-card-effect">{{effectText}}</small>
            </div>
            <div class="scg-play-actions">
              {{#each rowChoices}}
                <button type="button" data-action="play-card" data-card-id="{{../id}}" data-row="{{id}}" {{#unless @root.canPlayerAct}}disabled{{/unless}}><i class="{{icon}}"></i> {{label}}</button>
              {{/each}}
            </div>
          </article>
        {{/each}}
      </div>
    </section>
  {{/if}}
</section>
