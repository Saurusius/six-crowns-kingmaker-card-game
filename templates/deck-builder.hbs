<section class="scg-profile-shell scg-builder-shell {{#if analysisCompact}}is-analysis-compact{{/if}}">
  <header class="scg-profile-toolbar">
    <div>
      <h1>Constructeur de deck</h1>
      <p>Collection de {{userName}} · Mélange libre des factions · Exactement {{requiredTotal}} cartes.</p>
    </div>
    <div class="scg-builder-header-actions">
      <button type="button" data-action="open-glossary"><i class="fa-solid fa-book-open"></i> Glossaire</button>
      <div class="scg-builder-total {{#if complete}}is-complete{{/if}} {{#if overLimit}}is-over{{/if}}">
        <strong>{{total}} / {{requiredTotal}}</strong>
        {{#if valid}}<span>Deck valide</span>{{else}}{{#if overLimit}}<span>Trop de cartes</span>{{else}}<span>{{remaining}} restante(s)</span>{{/if}}{{/if}}
      </div>
    </div>
  </header>

  <section class="scg-builder-management">
    <label class="scg-builder-name">
      <span>Nom du deck</span>
      <input type="text" name="deck-name" value="{{draft.name}}" maxlength="60" placeholder="Mon deck des Terres Dérobées">
    </label>
    <label>
      <span>Decks enregistrés</span>
      <select name="saved-deck">
        <option value="">— Choisir un deck —</option>
        {{#each decks}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} — {{cardCount}} cartes</option>{{/each}}
      </select>
    </label>
    <div class="scg-builder-management-actions">
      <button type="button" data-action="load-deck"><i class="fa-solid fa-folder-open"></i> Charger</button>
      <button type="button" data-action="new-deck"><i class="fa-solid fa-file-circle-plus"></i> Nouveau</button>
      <button type="button" data-action="save-deck" {{#unless canSave}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
      <button type="button" data-action="rename-deck" {{#unless canRename}}disabled{{/unless}}><i class="fa-solid fa-pen"></i> Renommer</button>
      <button type="button" data-action="duplicate-deck" {{#unless canDuplicate}}disabled{{/unless}}><i class="fa-solid fa-copy"></i> Dupliquer</button>
      <button type="button" class="is-danger" data-action="delete-deck" {{#unless canDelete}}disabled{{/unless}} title="Supprimer"><i class="fa-solid fa-trash"></i></button>
    </div>
  </section>

  {{#if hasValidationErrors}}
    <section class="scg-deck-validation is-invalid">
      <div>
        <strong><i class="fa-solid fa-triangle-exclamation"></i> Ce deck n’est pas encore valide</strong>
        <span>Corrigez les points suivants avant de l’enregistrer ou de le jouer :</span>
      </div>
      <ul>{{#each validationErrors}}<li>{{this}}</li>{{/each}}</ul>
    </section>
  {{else}}
    <section class="scg-deck-validation is-valid">
      <strong><i class="fa-solid fa-circle-check"></i> Deck valide : 20 cartes · 3 exemplaires par Commune ou Peu commune · 2 par Rare · 1 par Unique.</strong>
    </section>
  {{/if}}

  <div class="scg-deck-analysis-toolbar">
    <strong><i class="fa-solid fa-chart-simple"></i> Analyse du deck</strong>
    <button type="button" data-action="toggle-analysis-size" aria-pressed="{{analysisCompact}}">
      <i class="{{analysisToggleIcon}}"></i> {{analysisToggleLabel}}
    </button>
  </div>

  <section class="scg-deck-analysis">
    <article class="scg-analysis-card">
      <header><strong>Courbe de force</strong><span>Force moyenne : {{statistics.averageStrength}}</span></header>
      <div class="scg-analysis-bars">
        {{#each statistics.strengthCurve}}
          <div class="scg-analysis-row">
            <span>{{label}}</span>
            <div class="scg-analysis-track"><i style="--scg-bar-width: {{percent}}%;"></i></div>
            <b>{{count}}</b>
          </div>
        {{/each}}
      </div>
    </article>
    <article class="scg-analysis-card">
      <header><strong>Répartition des lignes</strong><span>Une carte mobile compte sur chaque ligne autorisée.</span></header>
      <div class="scg-analysis-bars">{{#each statistics.rowDistribution}}<div class="scg-analysis-row"><span>{{label}}</span><div class="scg-analysis-track"><i style="--scg-bar-width: {{percent}}%;"></i></div><b>{{count}}</b></div>{{/each}}</div>
    </article>
    <article class="scg-analysis-card">
      <header><strong>Raretés</strong><span>Contrôlez la concentration des cartes prestigieuses.</span></header>
      <div class="scg-analysis-bars">{{#each statistics.rarityDistribution}}<div class="scg-analysis-row"><span>{{label}}</span><div class="scg-analysis-track"><i style="--scg-bar-width: {{percent}}%;"></i></div><b>{{count}}</b></div>{{/each}}</div>
    </article>
    <article class="scg-analysis-card">
      <header><strong>Types</strong><span>Personnages, unités et tactiques.</span></header>
      <div class="scg-analysis-bars">{{#each statistics.typeDistribution}}<div class="scg-analysis-row"><span>{{label}}</span><div class="scg-analysis-track"><i style="--scg-bar-width: {{percent}}%;"></i></div><b>{{count}}</b></div>{{/each}}</div>
    </article>
    <article class="scg-analysis-card">
      <header><strong>Capacités</strong><span>Répartition des mécaniques du deck.</span></header>
      <div class="scg-analysis-bars">{{#each statistics.abilityDistribution}}<div class="scg-analysis-row"><span>{{label}}</span><div class="scg-analysis-track"><i style="--scg-bar-width: {{percent}}%;"></i></div><b>{{count}}</b></div>{{/each}}</div>
    </article>
  </section>

  <div class="scg-builder-layout">
    <section class="scg-builder-library">
      <header>
        <div>
          <h2>Cartes disponibles</h2>
          <p>Le nombre utilisable dépend de vos exemplaires possédés et de la limite propre à chaque carte.</p>
        </div>
        <div class="scg-profile-filters scg-builder-filters">
          <input type="search" name="builder-search" value="{{search}}" placeholder="Rechercher par nom…">
          <select name="builder-faction"><option value="all">Toutes les collections</option>{{#each factionOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <select name="builder-rarity"><option value="all">Toutes les raretés</option>{{#each rarityOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <select name="builder-type"><option value="all">Tous les types</option>{{#each typeOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <select name="builder-row"><option value="all">Toutes les lignes</option>{{#each rowOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <select name="builder-trait"><option value="all">Toutes les capacités</option>{{#each traitOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <select name="builder-sort" aria-label="Trier les cartes">
            {{#each sortOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>Tri : {{label}}</option>{{/each}}
          </select>
        </div>
      </header>

      <div class="scg-builder-card-list">
        {{#each cards}}
          <article class="scg-builder-card scg-rarity-{{rarity}} {{#unless canAdd}}is-add-blocked{{/unless}}" data-builder-card data-action="quick-add-card" data-card-id="{{id}}" data-faction="{{faction}}" data-rarity="{{rarity}}" data-type="{{type}}" data-rows="{{#each rows}}{{this}} {{/each}}" data-traits="{{filterTraits}}" data-search="{{name}} {{factionLabel}} {{rarityLabel}} {{typeLabel}} {{traitSummary}}" title="Clic : ajouter · clic droit : retirer{{#if addDisabledReason}} · {{addDisabledReason}}{{/if}}">
            <span class="scg-builder-symbol {{#if hasArt}}has-art{{/if}}">{{#if hasArt}}<img src="{{artThumb}}" alt="Illustration de {{name}}" loading="lazy" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">{{else}}{{factionSymbol}}{{/if}}</span>
            <div class="scg-builder-card-info">
              <strong>{{name}}</strong>
              <small>{{factionLabel}} · <i class="{{typeIcon}}"></i> {{typeLabel}} · {{rarityLabel}} · Force {{strength}}</small>
              <span class="scg-card-symbol-line">{{#each rowBadges}}<span title="{{label}}"><i class="{{icon}}"></i> {{label}}</span>{{/each}}</span>
              <div class="scg-effect-icons scg-builder-traits">{{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}</div>
              <p class="scg-builder-card-effect">{{{textHtml}}}</p>
            </div>
            <div class="scg-builder-owned" aria-label="Exemplaires de la carte">
              <strong>Possédées : {{ownedCount}}</strong>
              <small>Utilisées : {{inDeck}}</small>
              <small>Disponibles : {{availableCount}}</small>
              <small>Limite du deck : {{maxCopies}}</small>
            </div>
            <div class="scg-builder-stepper" aria-label="Quantité dans le deck">
              <button type="button" data-action="remove-card" data-card-id="{{id}}" {{#unless canRemove}}disabled{{/unless}}>−</button>
              <strong>{{inDeck}}</strong>
              <button type="button" data-action="add-card" data-card-id="{{id}}" {{#unless canAdd}}disabled title="{{addDisabledReason}}"{{/unless}}>+</button>
            </div>
          </article>
        {{else}}
          <div class="scg-builder-empty">
            <i class="fa-solid fa-box-open"></i>
            <strong>Aucune carte jouable possédée</strong>
            <p>Ouvrez quelques boosters depuis le plateau ou la collection pour commencer.</p>
          </div>
        {{/each}}
      </div>
    </section>

    <aside class="scg-builder-deck-list">
      <header><h2>Deck actuel</h2><span>{{total}} carte(s)</span></header>
      <div class="scg-builder-selected-scroll">
        {{#each selectedCards}}
          <article class="scg-builder-selected scg-rarity-{{rarity}}">
            <span class="scg-builder-selected-art {{#if hasArt}}has-art{{/if}}">{{#if hasArt}}<img src="{{artThumb}}" alt="Illustration de {{name}}" loading="lazy" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">{{else}}{{factionSymbol}}{{/if}}</span>
            <div>
              <strong>{{name}}</strong>
              <small><i class="{{typeIcon}}"></i> {{typeLabel}} · {{rarityLabel}} · possédées {{ownedCount}} · utilisées {{inDeck}}</small>
              <div class="scg-effect-icons scg-builder-selected-traits">
                {{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}
              </div>
            </div>
            <button type="button" data-action="remove-card" data-card-id="{{id}}">−</button>
            <b>×{{inDeck}}</b>
            <button type="button" data-action="add-card" data-card-id="{{id}}" {{#unless canAdd}}disabled title="{{addDisabledReason}}"{{/unless}}>+</button>
          </article>
        {{else}}
          <p class="scg-builder-empty-deck">Ajoutez des cartes depuis votre collection.</p>
        {{/each}}
      </div>
    </aside>
  </div>
</section>
