<section class="scg-profile-shell scg-builder-shell">
  <header class="scg-profile-toolbar">
    <div>
      <h1>Constructeur de deck</h1>
      <p>Collection de {{userName}} · Mélange libre des factions · Exactement {{requiredTotal}} cartes.</p>
    </div>
    <div class="scg-builder-header-actions">
      <button type="button" data-action="open-home"><i class="fa-solid fa-house"></i> Accueil</button>
      <button type="button" data-action="open-glossary"><i class="fa-solid fa-book-open"></i> Glossaire</button>
      <button type="button" data-action="toggle-library-view"><i class="{{libraryViewIcon}}"></i> {{libraryViewLabel}}</button>
      <button type="button" data-action="open-deck-analysis"><i class="fa-solid fa-chart-column"></i> Analyser le deck</button>
      <div class="scg-builder-total {{#if complete}}is-complete{{/if}} {{#if overLimit}}is-over{{/if}}">
        <strong>{{total}} / {{requiredTotal}}</strong>
        {{#if valid}}<span>Deck valide</span>{{else}}{{#if overLimit}}<span>Trop de cartes</span>{{else}}<span>{{remaining}} restante(s)</span>{{/if}}{{/if}}
      </div>
    </div>
  </header>

  <div class="scg-builder-layout" data-preserve-scroll="layout">
    <section class="scg-builder-library {{#if isCarouselView}}is-carousel-view{{/if}}">
      <header class="scg-builder-library-heading">
        <div>
          <h2>Cartes disponibles</h2>
          <p>Cliquez sur une carte pour l’ajouter. Clic droit pour retirer un exemplaire.</p>
        </div>
        <span class="scg-builder-library-hint"><i class="{{libraryViewIcon}}"></i> {{#if isCarouselView}}Vue carrousel{{else}}Vue mosaïque{{/if}}</span>
      </header>

      <div class="scg-builder-filter-panel" aria-label="Filtres du constructeur de deck">
        <label class="scg-builder-search-field">
          <span><i class="fa-solid fa-magnifying-glass"></i> Rechercher</span>
          <input type="search" name="builder-search" value="{{search}}" placeholder="Nom, faction, capacité…">
        </label>
        <div class="scg-builder-filter-grid">
          <label><span>Collection</span><select name="builder-faction"><option value="all">Toutes les collections</option>{{#each factionOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label><span>Rareté</span><select name="builder-rarity"><option value="all">Toutes les raretés</option>{{#each rarityOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label><span>Type</span><select name="builder-type"><option value="all">Tous les types</option>{{#each typeOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label><span>Ligne</span><select name="builder-row"><option value="all">Toutes les lignes</option>{{#each rowOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label><span>Capacité</span><select name="builder-trait"><option value="all">Toutes les capacités</option>{{#each traitOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label><span>Tri</span><select name="builder-sort" aria-label="Trier les cartes">{{#each sortOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        </div>
      </div>

      <div class="scg-builder-card-list scg-builder-card-grid {{#if isCarouselView}}is-carousel{{/if}}" data-preserve-scroll="library">
        {{#each cards}}
          <article class="scg-builder-card scg-builder-tile scg-rarity-{{rarity}} {{#unless canAdd}}is-add-blocked{{/unless}}" data-builder-card data-action="quick-add-card" data-card-id="{{id}}" data-faction="{{faction}}" data-rarity="{{rarity}}" data-type="{{type}}" data-rows="{{#each rows}}{{this}} {{/each}}" data-traits="{{filterTraits}}" data-search="{{name}} {{factionLabel}} {{rarityLabel}} {{typeLabel}} {{traitSummary}}" title="Clic : ajouter · clic droit : retirer{{#if addDisabledReason}} · {{addDisabledReason}}{{/if}}">
            <div class="scg-builder-card-art {{#if hasArt}}has-art{{/if}}">
              {{#if hasArt}}<img src="{{artMedium}}" alt="Illustration de {{name}}" loading="lazy" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">{{else}}<span class="scg-builder-card-placeholder">{{factionSymbol}}</span>{{/if}}
              <strong class="scg-builder-strength">{{strength}}</strong>
              <span class="scg-rarity-badge scg-rarity-{{rarity}}" title="{{rarityLabel}}"><i class="{{rarityIcon}}"></i></span>
              <span class="scg-row-emblem" title="{{#each rowBadges}}{{label}}{{#unless @last}} · {{/unless}}{{/each}}"><i class="{{primaryRowIcon}}"></i></span>
            </div>
            <div class="scg-builder-card-info">
              <strong title="{{name}}">{{name}}</strong>
              <small class="scg-builder-meta"><i class="{{typeIcon}}"></i> {{typeLabel}} · {{factionLabel}}</small>
              <span class="scg-card-symbol-line">{{#each rowBadges}}<span title="{{label}}"><i class="{{icon}}"></i> {{label}}</span>{{/each}}</span>
              <div class="scg-effect-icons scg-builder-traits">{{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}</div>
              <p class="scg-builder-card-effect" tabindex="0" title="{{text}}" aria-label="Effet de {{name}} : {{text}}">{{{textHtml}}}</p>
            </div>
            <footer class="scg-builder-tile-footer">
              <div class="scg-builder-owned" aria-label="Exemplaires de la carte">
                <strong>{{ownedCount}} possédée(s)</strong>
                <small>{{inDeck}} dans le deck · limite {{maxCopies}}</small>
              </div>
              <div class="scg-builder-stepper" aria-label="Quantité dans le deck">
                <button type="button" data-action="remove-card" data-card-id="{{id}}" {{#unless canRemove}}disabled{{/unless}} aria-label="Retirer {{name}}">−</button>
                <strong>{{inDeck}}</strong>
                <button type="button" data-action="add-card" data-card-id="{{id}}" {{#unless canAdd}}disabled title="{{addDisabledReason}}"{{/unless}} aria-label="Ajouter {{name}}">+</button>
              </div>
            </footer>
          </article>
        {{else}}
          <div class="scg-builder-empty">
            <i class="fa-solid fa-box-open"></i>
            <strong>Aucune carte jouable possédée</strong>
            <p>Ouvrez quelques boosters depuis le plateau ou la collection pour commencer.</p>
          </div>
        {{/each}}
      </div>
    </section>

    <aside class="scg-builder-deck-list">
      <header><h2>Deck actuel</h2><span>{{total}} carte(s)</span></header>

      <section class="scg-builder-side-management" aria-label="Gestion du deck">
        <label class="scg-builder-name">
          <span>Nom du deck</span>
          <input type="text" name="deck-name" value="{{draft.name}}" maxlength="60" placeholder="Mon deck des Terres Dérobées">
        </label>
        <label>
          <span>Decks enregistrés</span>
          <select name="saved-deck">
            <option value="">— Choisir un deck —</option>
            {{#each decks}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} — {{cardCount}} cartes</option>{{/each}}
          </select>
        </label>
        <div class="scg-builder-side-actions">
          <button type="button" data-action="new-deck"><i class="fa-solid fa-file-circle-plus"></i> Nouveau</button>
          <button type="button" data-action="load-deck"><i class="fa-solid fa-folder-open"></i> Charger</button>
          <button type="button" class="is-primary" data-action="save-deck" {{#unless canSave}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
          <button type="button" data-action="rename-deck" {{#unless canRename}}disabled{{/unless}}><i class="fa-solid fa-pen"></i> Renommer</button>
          <button type="button" data-action="duplicate-deck" {{#unless canDuplicate}}disabled{{/unless}}><i class="fa-solid fa-copy"></i> Dupliquer</button>
          <button type="button" class="is-danger" data-action="delete-deck" {{#unless canDelete}}disabled{{/unless}}><i class="fa-solid fa-trash"></i> Supprimer</button>
        </div>
      </section>

      {{#if hasValidationErrors}}
        <section class="scg-deck-validation is-invalid scg-builder-side-validation">
          <strong><i class="fa-solid fa-triangle-exclamation"></i> Deck incomplet</strong>
          <ul>{{#each validationErrors}}<li>{{this}}</li>{{/each}}</ul>
        </section>
      {{else}}
        <section class="scg-deck-validation is-valid scg-builder-side-validation">
          <strong><i class="fa-solid fa-circle-check"></i> Deck valide</strong>
          <span>Prêt à être enregistré et joué.</span>
        </section>
      {{/if}}

      <div class="scg-builder-selected-scroll" data-preserve-scroll="selected">
        {{#each selectedCards}}
          <article class="scg-builder-selected scg-rarity-{{rarity}}">
            <span class="scg-builder-selected-art {{#if hasArt}}has-art{{/if}}">{{#if hasArt}}<img src="{{artThumb}}" alt="Illustration de {{name}}" loading="lazy" data-scg-art-fallback data-fallback-symbol="{{factionSymbol}}">{{else}}{{factionSymbol}}{{/if}}</span>
            <div>
              <strong>{{name}}</strong>
              <small><i class="{{typeIcon}}"></i> {{typeLabel}} · {{rarityLabel}} · possédées {{ownedCount}} · utilisées {{inDeck}}</small>
              <div class="scg-effect-icons scg-builder-selected-traits">
                {{#each traitBadges}}<span class="scg-trait-icon" data-scg-trait-icon tabindex="0" aria-label="{{label}} — {{description}}"><img src="{{iconUrl}}" alt=""><span class="scg-trait-tooltip"><strong>{{label}}</strong><small>{{description}}</small></span></span>{{/each}}
              </div>
            </div>
            <button type="button" data-action="remove-card" data-card-id="{{id}}">−</button>
            <b>×{{inDeck}}</b>
            <button type="button" data-action="add-card" data-card-id="{{id}}" {{#unless canAdd}}disabled title="{{addDisabledReason}}"{{/unless}}>+</button>
          </article>
        {{else}}
          <p class="scg-builder-empty-deck">Ajoutez des cartes depuis votre collection.</p>
        {{/each}}
      </div>
    </aside>
  </div>
</section>
