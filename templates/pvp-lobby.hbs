<section class="scg-pvp-shell">
  <header class="scg-pvp-header">
    <div>
      <small>Multijoueur en ligne · bêta</small>
      <h1><i class="fa-solid fa-khanda"></i> Arène des Six Couronnes</h1>
      <p>Invitez un joueur connecté, verrouillez votre deck et votre sortilège, puis laissez parler les cartes.</p>
    </div>
    <div class="scg-pvp-header-actions">
      <span class="scg-pvp-version">v{{version}}</span>
      <button type="button" data-action="refresh"><i class="fa-solid fa-rotate"></i> Actualiser</button>
      <button type="button" data-action="open-home"><i class="fa-solid fa-house"></i> Accueil</button>
    </div>
  </header>

  {{#unless hasHost}}
    <div class="scg-pvp-alert is-danger"><i class="fa-solid fa-triangle-exclamation"></i><div><strong>Aucun MJ hôte connecté</strong><p>Un MJ doit rester connecté pour arbitrer, sauvegarder et resynchroniser les duels.</p></div></div>
  {{else}}
    <div class="scg-pvp-alert"><i class="fa-solid fa-server"></i><div><strong>Serveur PvP prêt</strong><p>{{hostGmName}} assure l’arbitrage technique des parties.</p></div></div>
  {{/unless}}

  <div class="scg-pvp-grid">
    <main class="scg-pvp-main">
      {{#if hasInvitations}}
        <section class="scg-pvp-panel is-invitations">
          <header><div><small>Défis en attente</small><h2>Invitations</h2></div><i class="fa-solid fa-envelope-open-text"></i></header>
          <div class="scg-pvp-invite-list">
            {{#each invitations}}
              <article>
                <div class="scg-pvp-versus-mini"><img src="{{player.avatar}}" alt=""><span>VS</span><img src="{{opponentSeat.avatar}}" alt=""></div>
                <div><strong>{{player.name}} contre {{opponentSeat.name}}</strong><small>{{#if isIncoming}}Vous êtes défié.{{else}}Invitation envoyée.{{/if}}</small></div>
                <div class="scg-pvp-inline-actions">
                  {{#if isIncoming}}
                    <button type="button" class="scg-primary-button" data-action="accept-invite" data-match-id="{{id}}"><i class="fa-solid fa-check"></i> Accepter</button>
                    <button type="button" data-action="reject-invite" data-match-id="{{id}}"><i class="fa-solid fa-xmark"></i> Refuser</button>
                  {{else}}
                    <button type="button" data-action="cancel-invite" data-match-id="{{id}}"><i class="fa-solid fa-ban"></i> Annuler</button>
                  {{/if}}
                </div>
              </article>
            {{/each}}
          </div>
        </section>
      {{/if}}

      {{#if isLobby}}
        <section class="scg-pvp-panel is-lobby">
          <header><div><small>Salon privé</small><h2>Préparation du duel</h2></div><span class="scg-pvp-status-chip">En attente des joueurs</span></header>
          <div class="scg-pvp-duelists">
            <article class="{{#if currentLobby.own.ready}}is-ready{{/if}}">
              <img src="{{currentLobby.own.avatar}}" alt="Portrait de {{currentLobby.own.name}}">
              <div><small>Vous</small><strong>{{currentLobby.own.name}}</strong><span>{{currentLobby.own.deckName}}</span><em>{{currentLobby.own.spellName}}</em></div>
              <i class="fa-solid {{#if currentLobby.own.ready}}fa-circle-check{{else}}fa-hourglass-half{{/if}}"></i>
            </article>
            <div class="scg-pvp-vs">VS</div>
            <article class="{{#if currentLobby.opponent.ready}}is-ready{{/if}}">
              <img src="{{currentLobby.opponent.avatar}}" alt="Portrait de {{currentLobby.opponent.name}}">
              <div><small>Adversaire</small><strong>{{currentLobby.opponent.name}}</strong><span>{{currentLobby.opponent.deckName}}</span><em>{{currentLobby.opponent.spellName}}</em></div>
              <i class="fa-solid {{#if currentLobby.opponent.ready}}fa-circle-check{{else}}fa-hourglass-half{{/if}}"></i>
            </article>
          </div>

          <div class="scg-pvp-loadout">
            <label><span><i class="fa-solid fa-layer-group"></i> Votre deck</span>
              <select name="pvp-deck">
                {{#each deckOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
              </select>
            </label>
            <div class="scg-pvp-spell-picker">
              <span><i class="fa-solid fa-wand-sparkles"></i> Sortilège emblématique</span>
              <div class="scg-pvp-spell-carousel">
                {{#each spellOptions}}
                  <button type="button" class="{{#if selected}}is-selected{{/if}}" data-action="select-pvp-spell" data-spell-id="{{id}}">
                    {{#if artMedium}}<img src="{{artMedium}}" alt="">{{else}}<i class="fa-solid fa-ban"></i>{{/if}}
                    <strong>{{name}}</strong>
                  </button>
                {{/each}}
              </div>
            </div>
          </div>

          <div class="scg-pvp-lobby-footer">
            <label class="scg-pvp-toggle"><input type="checkbox" data-action="toggle-spectators" {{#if currentLobby.allowSpectators}}checked{{/if}}><span>Autoriser les spectateurs</span></label>
            <div class="scg-pvp-inline-actions">
              <button type="button" class="scg-danger-button" data-action="leave-lobby"><i class="fa-solid fa-door-open"></i> Quitter le salon</button>
              <button type="button" data-action="save-loadout"><i class="fa-solid fa-floppy-disk"></i> Valider mon équipement</button>
              <button type="button" class="scg-primary-button" data-action="toggle-ready" {{#unless currentLobby.own.hasDeck}}disabled{{/unless}}><i class="fa-solid {{#if currentLobby.own.ready}}fa-lock-open{{else}}fa-lock{{/if}}"></i> {{#if currentLobby.own.ready}}Ne plus être prêt{{else}}Je suis prêt{{/if}}</button>
            </div>
          </div>
        </section>
      {{else}}{{#if hasCurrent}}
        <section class="scg-pvp-panel is-current">
          <header><div><small>Duel {{#if isCompleted}}terminé{{else}}en cours{{/if}}</small><h2>{{currentSummary.player.name}} contre {{currentSummary.opponentSeat.name}}</h2></div><span class="scg-pvp-status-chip {{#if isCompleted}}is-complete{{/if}}">{{#if isCompleted}}Résultat disponible{{else}}Manche {{currentSummary.round}}{{/if}}</span></header>
          <div class="scg-pvp-resume-card">
            <div class="scg-pvp-versus-large"><img src="{{currentSummary.player.avatar}}" alt=""><span>VS</span><img src="{{currentSummary.opponentSeat.avatar}}" alt=""></div>
            <div><strong>{{#if isCompleted}}{{#if currentSummary.isTie}}Égalité finale{{else}}{{currentSummary.winnerName}} remporte le duel{{/if}}{{else}}Votre partie vous attend{{/if}}</strong><p>La partie est sauvegardée par le MJ et peut être reprise après une reconnexion.</p></div>
            <button type="button" class="scg-primary-button" data-action="open-match" data-match-id="{{currentSummary.id}}"><i class="fa-solid fa-door-open"></i> {{#if isCompleted}}Voir le résultat{{else}}Reprendre le duel{{/if}}</button>
          </div>
        </section>
      {{else}}
        <section class="scg-pvp-panel">
          <header><div><small>Nouveau duel</small><h2>Joueurs connectés</h2></div><i class="fa-solid fa-users"></i></header>
          {{#if hasConnectedPlayers}}
            <div class="scg-pvp-player-list">
              {{#each connectedPlayers}}
                <article><img src="{{avatar}}" alt="Portrait de {{name}}"><div><strong>{{name}}</strong><small>{{#if isGM}}Maître du jeu{{else}}Joueur connecté{{/if}}</small></div><button type="button" data-action="invite" data-user-id="{{id}}" {{#unless @root.hasHost}}disabled{{/unless}}><i class="fa-solid fa-khanda"></i> Défier</button></article>
              {{/each}}
            </div>
          {{else}}
            <div class="scg-pvp-empty"><i class="fa-solid fa-ghost"></i><strong>Personne à défier pour le moment</strong><p>Les autres joueurs apparaîtront ici dès qu’ils seront connectés.</p></div>
          {{/if}}
        </section>
      {{/if}}{{/if}}

      {{#if hasSpectatable}}
        <section class="scg-pvp-panel">
          <header><div><small>Tribunes ouvertes</small><h2>Duels à observer</h2></div><i class="fa-solid fa-eye"></i></header>
          <div class="scg-pvp-spectate-list">
            {{#each spectatable}}<article><span><strong>{{player.name}} contre {{opponentSeat.name}}</strong><small>Manche {{round}}</small></span><button type="button" data-action="spectate" data-match-id="{{id}}"><i class="fa-solid fa-eye"></i> Observer</button></article>{{/each}}
          </div>
        </section>
      {{/if}}
    </main>

    <aside class="scg-pvp-sidebar">
      <section class="scg-pvp-panel is-stats">
        <header><div><small>Votre parcours</small><h2>Statistiques PvP</h2></div><i class="fa-solid fa-chart-simple"></i></header>
        <div class="scg-pvp-stats-grid"><span><strong>{{stats.played}}</strong><small>Duels</small></span><span><strong>{{stats.wins}}</strong><small>Victoires</small></span><span><strong>{{stats.losses}}</strong><small>Défaites</small></span><span><strong>{{stats.ties}}</strong><small>Égalités</small></span></div>
      </section>

      <section class="scg-pvp-panel is-help">
        <header><div><small>Références</small><h2>Avant de jouer</h2></div><i class="fa-solid fa-book"></i></header>
        <button type="button" data-action="open-rulebook"><i class="fa-solid fa-scroll"></i><span><strong>Règlement</strong><small>Tours, lignes et victoire</small></span></button>
        <button type="button" data-action="open-glossary"><i class="fa-solid fa-book-open"></i><span><strong>Glossaire</strong><small>Traits et effets de cartes</small></span></button>
      </section>

      <section class="scg-pvp-panel is-history">
        <header><div><small>Derniers affrontements</small><h2>Historique</h2></div><i class="fa-solid fa-clock-rotate-left"></i></header>
        {{#if hasRecent}}<div class="scg-pvp-history-list">{{#each recent}}<article class="is-{{resultLabel}}"><div><strong>{{resultLabel}}</strong><span>{{playerName}} · {{opponentName}}</span></div><small>{{dateLabel}}</small></article>{{/each}}</div>{{else}}<div class="scg-pvp-empty is-small"><p>Aucun duel terminé.</p></div>{{/if}}
      </section>
    </aside>
  </div>

  {{#if isHostGm}}
    <section class="scg-pvp-panel scg-pvp-admin">
      <header><div><small>Arbitrage technique</small><h2>Console MJ</h2></div><i class="fa-solid fa-gavel"></i></header>
      {{#if hasAdminMatches}}
        <div class="scg-pvp-admin-list">
          {{#each adminMatches}}
            <article>
              <div><strong>{{player.name}} contre {{opponentSeat.name}}</strong><small>{{statusLabel}}{{#if round}} · manche {{round}}{{/if}}</small></div>
              <div class="scg-pvp-inline-actions">
                <button type="button" data-action="admin-resync" data-match-id="{{id}}" title="Renvoyer l’état"><i class="fa-solid fa-arrows-rotate"></i></button>
                {{#if canAdminForceTurn}}<button type="button" data-action="admin-force-turn" data-match-id="{{id}}" title="Forcer le changement de tour"><i class="fa-solid fa-forward-step"></i></button>{{/if}}
                {{#if canAdminDeclareWinner}}<button type="button" data-action="admin-winner" data-match-id="{{id}}" data-winner="player" title="Déclarer le premier joueur vainqueur"><i class="fa-solid fa-trophy"></i> J1</button><button type="button" data-action="admin-winner" data-match-id="{{id}}" data-winner="opponent" title="Déclarer le second joueur vainqueur"><i class="fa-solid fa-trophy"></i> J2</button>{{/if}}
                {{#if canAdminCancel}}<button type="button" data-action="admin-cancel" data-match-id="{{id}}" title="Annuler le duel"><i class="fa-solid fa-trash"></i></button>{{/if}}
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}<div class="scg-pvp-empty is-small"><p>Aucun duel à administrer.</p></div>{{/if}}
    </section>
  {{/if}}
</section>
